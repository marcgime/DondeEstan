# =============================================================================
# .gitignore — DondeEstan
# =============================================================================

# --- Secretos, Entornos y Credenciales (PROHIBIDO EN GIT) ---
.env
.env.*
*.pem
*.key
*.keystore
*.p12

# --- Sistema Operativo e IDEs ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Caché del Arnés y Herramientas ---
.tools/
*.log
replay_pid*
coverage/

# --- Node & Web / React Native ---
node_modules/
dist/
build/
.next/
out/
.expo/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
