{
  "$schema": "design-tokens/1.0.0",
  "meta": {
    "name": "DondeEstan Design Tokens (iOS Native Terracotta)",
    "version": "2.0.0",
    "updated": "2026-11-25",
    "authority": "values",
    "notes": "Tokens nativos iOS con fondo agrupado #F2F2F7, superficies #FFFFFF sin sombras pesadas y acento Terracota #C85A32."
  },
  "color": {
    "surface": {
      "canvas": "#F2F2F7",
      "base": "#F9F9FB",
      "elevated": "#FFFFFF",
      "inset": "#E5E5EA",
      "highest": "#D1D1D6",
      "overlay": "rgba(0, 0, 0, 0.30)",
      "glass": "rgba(249, 249, 251, 0.78)"
    },
    "border": {
      "subtle": "rgba(60, 60, 67, 0.12)",
      "strong": "rgba(0, 0, 0, 0.06)",
      "focus": "#C85A32",
      "specular": "rgba(255, 255, 255, 0.80)"
    },
    "text": {
      "primary": "#1C1C1E",
      "secondary": "#636366",
      "disabled": "#AEAEB2",
      "onAccent": "#FFFFFF",
      "accent": "#C85A32",
      "inverse": "#F9F9FB"
    },
    "accent": {
      "primary": "#C85A32",
      "primaryContainer": "#E67248",
      "onPrimary": "#FFFFFF",
      "onPrimaryContainer": "#FDECE6",
      "secondary": "#8E8E93",
      "secondaryContainer": "#E5E5EA",
      "onSecondary": "#FFFFFF",
      "onSecondaryContainer": "#1C1C1E",
      "tertiary": "#2E7D32",
      "tertiaryContainer": "#E8F5E9",
      "onTertiary": "#FFFFFF",
      "onTertiaryContainer": "#1B5E20"
    },
    "status": {
      "online": "#2E7D32",
      "offline": "#8E8E93",
      "warning": "#C85A32",
      "error": "#D32F2F",
      "info": "#C85A32"
    }
  },
  "type": {
    "family": {
      "primary": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", sans-serif",
      "mono": "\"SF Mono\", ui-monospace, Menlo, monospace"
    },
    "display": {
      "size": 34,
      "lineHeight": 1.18,
      "weight": 700,
      "letterSpacing": "-0.02em"
    },
    "title": {
      "size": 22,
      "lineHeight": 1.27,
      "weight": 600,
      "letterSpacing": "-0.01em"
    },
    "heading": {
      "size": 17,
      "lineHeight": 1.33,
      "weight": 600
    },
    "body": {
      "size": 17,
      "lineHeight": 1.45,
      "weight": 400
    },
    "label": {
      "size": 13,
      "lineHeight": 1.33,
      "weight": 500,
      "letterSpacing": "0.01em"
    },
    "caption": {
      "size": 10,
      "lineHeight": 1.2,
      "weight": 500,
      "letterSpacing": "0.01em"
    }
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 10,
    "md": 14,
    "lg": 20,
    "xl": 24,
    "full": 9999
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "curve": "cubic-bezier(0.2, 0.0, 0, 1.0)"
  },
  "elevation": {
    "none": "none",
    "card": "none",
    "dock": "0 8px 24px rgba(0, 0, 0, 0.08)",
    "alert": "0 8px 24px rgba(0, 0, 0, 0.08)"
  },
  "layout": {
    "unit": 4,
    "maxContentWidth": 1200,
    "safeAreaTop": "env(safe-area-inset-top)",
    "safeAreaBottom": "env(safe-area-inset-bottom)"
  }
}
