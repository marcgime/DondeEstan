{
  "$schema": "design-tokens/1.0.0",
  "meta": {
    "name": "DondeEstan Design Tokens (Kinetic Bloom)",
    "version": "1.0.0",
    "updated": "2026-11-11",
    "authority": "values",
    "notes": "Tokens extra\u00eddos directamente del proyecto Stitch Family Expressive PWA (Kinetic Bloom). Cero valores literales en c\u00f3digo de producci\u00f3n."
  },
  "color": {
    "surface": {
      "canvas": "#fff7ff",
      "base": "#faf1fc",
      "elevated": "#f4ebf7",
      "inset": "#eee5f1",
      "highest": "#e8e0eb",
      "overlay": "rgba(30, 26, 34, 0.72)",
      "glass": "rgba(255, 255, 255, 0.78)"
    },
    "border": {
      "subtle": "#cac3d9",
      "strong": "#797488",
      "focus": "#5200e3",
      "specular": "rgba(255, 255, 255, 0.6)"
    },
    "text": {
      "primary": "#1e1a22",
      "secondary": "#484456",
      "disabled": "#797488",
      "onAccent": "#ffffff",
      "accent": "#5200e3",
      "inverse": "#fff7ff"
    },
    "accent": {
      "primary": "#5200e3",
      "primaryContainer": "#6b38fb",
      "onPrimary": "#ffffff",
      "onPrimaryContainer": "#e7deff",
      "secondary": "#994537",
      "secondaryContainer": "#fd9482",
      "onSecondary": "#ffffff",
      "onSecondaryContainer": "#762b1f",
      "tertiary": "#31553d",
      "tertiaryContainer": "#496d54",
      "onTertiary": "#ffffff",
      "onTertiaryContainer": "#c5edce"
    },
    "status": {
      "online": "#31553d",
      "offline": "#797488",
      "warning": "#fd9482",
      "error": "#ba1a1a",
      "info": "#6b38fb"
    }
  },
  "type": {
    "family": {
      "primary": "Plus Jakarta Sans",
      "mono": "JetBrains Mono"
    },
    "display": {
      "size": 44,
      "lineHeight": 1.18,
      "weight": 800,
      "letterSpacing": "-0.025em"
    },
    "title": {
      "size": 24,
      "lineHeight": 1.33,
      "weight": 700,
      "letterSpacing": "-0.01em"
    },
    "heading": {
      "size": 18,
      "lineHeight": 1.33,
      "weight": 600
    },
    "body": {
      "size": 14,
      "lineHeight": 1.43,
      "weight": 400
    },
    "label": {
      "size": 12,
      "lineHeight": 1.33,
      "weight": 600,
      "letterSpacing": "0.02em"
    },
    "caption": {
      "size": 11,
      "lineHeight": 1.27,
      "weight": 700,
      "letterSpacing": "0.03em"
    }
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "full": 9999
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "curve": "cubic-bezier(0.2, 0.0, 0, 1.0)"
  },
  "elevation": {
    "none": "none",
    "card": "0 8px 24px -4px rgba(30, 26, 34, 0.06), 0 2px 6px -1px rgba(30, 26, 34, 0.04)",
    "dock": "0 16px 36px -6px rgba(40, 25, 68, 0.16)",
    "alert": "0 12px 32px 0 rgba(107, 56, 251, 0.28)"
  },
  "layout": {
    "unit": 4,
    "maxContentWidth": 1200,
    "safeAreaTop": "env(safe-area-inset-top)",
    "safeAreaBottom": "env(safe-area-inset-bottom)"
  }
}
